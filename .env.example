# =============================================
# Server Configuration
# =============================================
NODE_ENV=development
PORT=3000
APP_NAME=pos-api

# =============================================
# Database (PostgreSQL)
# =============================================
# Local (Docker compose):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pos_db
# AWS RDS (run backend on EC2): point host at the RDS endpoint and require TLS:
# DATABASE_URL=postgresql://<user>:<password>@<rds-endpoint>:5432/pos_db?sslmode=require

# =============================================
# Authentication
# =============================================
JWT_SECRET=please-change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d

# =============================================
# Logger
# =============================================
LOG_LEVEL=debug
